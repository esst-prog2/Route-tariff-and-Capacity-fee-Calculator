# The raw work export stays local (it names colleagues); the synthetic sample and the
# cleaned real tariffs in data/real/ are committed.
data/private/
*.xlsx
!data/sample/*.xlsx
!data/real/*.xlsx
# The Capacity Fee Workbook, built from the real tariffs only (python build_workbook.py).
!excel/*.xlsx

__pycache__/
.pytest_cache/
*.pyc
.venv/

# Secrets and per-machine settings never go into the repository.
.env
.streamlit/secrets.toml
.claude/settings.local.json

# Impeccable (npx impeccable install --providers=claude --scope=project) is reinstalled, not committed:
# it is 24 MB with a Windows binary. Its hooks live in .claude/settings.local.json, ignored above.
.claude/skills/impeccable/
.claude/agents/impeccable-*.md
# The teacher's class slides stay local.
08.pdf

# Impeccable runtime state (decision-page server logs and seeds); the decision payload and sketches in .impeccable/decision/ are committed.
.impeccable/questions/
.impeccable/decision/answer.txt
