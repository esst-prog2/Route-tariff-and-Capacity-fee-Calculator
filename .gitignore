# The raw work export stays local (it names colleagues); the synthetic sample and the
# cleaned real tariffs in data/real/ are committed.
data/private/
*.xlsx
!data/sample/*.xlsx
!data/real/*.xlsx

__pycache__/
.pytest_cache/
*.pyc
.venv/

# Secrets and per-machine settings never go into the repository.
.env
.streamlit/secrets.toml
.claude/settings.local.json
